# Sorting Demo — TriLang
# Demonstrates bubble sort on a small array

func bubble_sort(arr, n) {
    var i = 0;
    while (i < n - 1) {
        var j = 0;
        while (j < n - i - 1) {
            if (arr[j] > arr[j + 1]) {
                var temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

func main() {
    # Print numbers 1-10
    var i = 1;
    while (i <= 10) {
        print(i);
        i = i + 1;
    }
}
